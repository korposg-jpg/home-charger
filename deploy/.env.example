# Copy to .env (never commit it).

# Tailscale auth key: https://login.tailscale.com/admin/settings/keys
# (one-off, pre-approved).
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx

# Where persistent data lives. On TrueNAS use a dataset, e.g. /mnt/tank/apps/home-charger
DATA_DIR=./data

# Leave empty until install day, then set to the charger's OCPP id.
CSMS_ALLOWED_CHARGE_POINTS=
# Only if the charger supports OCPP security profile 1 (Basic auth).
CSMS_OCPP_BASIC_AUTH_PASSWORD=

TZ=UTC

# To build locally instead of pulling from GHCR:
# CSMS_IMAGE=home-charger-csms:dev
# SIM_IMAGE=home-charger-simulator:dev
